<?xml version="1.0" encoding="UTF-8"?>
<mgrdata>
  <plugin name="pmanore.php">
    <group>payment_method</group>
    <msg name="desc_short" lang="ru">anore</msg>
    <msg name="desc_short" lang="en">anore</msg>
    <msg name="desc_full" lang="ru">Приём платежей через anore</msg>
    <msg name="desc_full" lang="en">Accept payments with anore</msg>
    <msg name="price" lang="ru">Бесплатно</msg>
    <msg name="price" lang="en">Free</msg>
  </plugin>

  <metadata name="paymethod.edit.anore.php" type="form">
    <form>
      <page name="methodprops">
        <field name="api_url">
          <input type="text" name="api_url"/>
        </field>
        <field name="api_key">
          <input type="password" name="api_key" private="yes" required="yes"/>
        </field>
        <field name="api_secret">
          <input type="password" name="api_secret" private="yes"/>
        </field>
        <field name="webhook_secret">
          <input type="password" name="webhook_secret" private="yes" required="yes"/>
        </field>
        <field name="shop_id">
          <input type="text" name="shop_id"/>
        </field>
        <field name="methods">
          <input type="text" name="methods"/>
        </field>
        <field name="identity_source">
          <select name="identity_source" required="yes">
            <option value="email">identity_source_email</option>
            <option value="external_id">identity_source_external_id</option>
          </select>
        </field>
        <field name="franchise_enabled">
          <input type="checkbox" name="franchise_enabled"/>
        </field>
        <field name="franchise_type">
          <select name="franchise_type">
            <option value="telegram_bot">franchise_type_telegram_bot</option>
            <option value="website">franchise_type_website</option>
          </select>
        </field>
        <field name="franchise_address">
          <input type="text" name="franchise_address"/>
        </field>
        <field name="franchise_owner_telegram_id">
          <input type="text" name="franchise_owner_telegram_id"/>
        </field>
        <field name="franchise_owner_telegram_username">
          <input type="text" name="franchise_owner_telegram_username"/>
        </field>
      </page>
    </form>
  </metadata>

  <lang name="ru">
    <messages name="label_paymethod">
      <msg name="pmanore.php">anore</msg>
      <msg name="module_pmanore.php">anore</msg>
    </messages>
    <messages name="paymethod.edit.anore.php">
      <msg name="api_url">Адрес API</msg>
      <msg name="hint_api_url">Пусто — https://api.anore.cc. Адрес с /api/v1 тоже поддерживается</msg>
      <msg name="api_key">API-ключ</msg>
      <msg name="hint_api_key">Ключ магазина или аккаунта из личного кабинета anore</msg>
      <msg name="api_secret">Секрет API</msg>
      <msg name="hint_api_secret">Необязательный секрет подписи X-ZPay-Signature</msg>
      <msg name="webhook_secret">Секрет вебхука</msg>
      <msg name="hint_webhook_secret">Должен совпадать с секретом вебхука магазина в anore</msg>
      <msg name="shop_id">ID магазина</msg>
      <msg name="hint_shop_id">Укажите только для API-ключа уровня аккаунта</msg>
      <msg name="methods">Методы оплаты</msg>
      <msg name="hint_methods">Необязательно: sbp,card,yoomoney,crypto,crypto-old. Пусто — настройки магазина; dvnet и xrocket тоже поддерживаются</msg>
      <msg name="identity_source">Источник user_identity</msg>
      <msg name="hint_identity_source">Email безопасен по умолчанию. External ID использует стабильный ID клиента BILLmanager</msg>
      <msg name="identity_source_email">Email пользователя</msg>
      <msg name="identity_source_external_id">Внешний ID клиента BILLmanager</msg>
      <msg name="franchise_enabled">Передавать франшизу для каждого платежа</msg>
      <msg name="hint_franchise_enabled">Включайте только когда режим франшизы включён для магазина anore</msg>
      <msg name="franchise_type">Тип франшизы</msg>
      <msg name="franchise_type_telegram_bot">Telegram-бот</msg>
      <msg name="franchise_type_website">HTTPS-сайт</msg>
      <msg name="franchise_address">Адрес франшизы</msg>
      <msg name="hint_franchise_address">Имя Telegram-бота или канонический HTTPS origin без порта и пути</msg>
      <msg name="franchise_owner_telegram_id">Telegram ID владельца</msg>
      <msg name="hint_franchise_owner_telegram_id">Положительный ID до 9223372036854775807</msg>
      <msg name="franchise_owner_telegram_username">Username владельца</msg>
      <msg name="hint_franchise_owner_telegram_username">Необязательно: @ и 5–32 латинских букв, цифр или подчёркиваний</msg>
    </messages>
  </lang>

  <lang name="en">
    <messages name="label_paymethod">
      <msg name="pmanore.php">anore</msg>
      <msg name="module_pmanore.php">anore</msg>
    </messages>
    <messages name="paymethod.edit.anore.php">
      <msg name="api_url">API URL</msg>
      <msg name="hint_api_url">Empty uses https://api.anore.cc. URLs ending with /api/v1 are supported</msg>
      <msg name="api_key">API key</msg>
      <msg name="hint_api_key">Store or account API key from the anore dashboard</msg>
      <msg name="api_secret">API secret</msg>
      <msg name="hint_api_secret">Optional X-ZPay-Signature secret</msg>
      <msg name="webhook_secret">Webhook secret</msg>
      <msg name="hint_webhook_secret">Must match the store webhook secret in anore</msg>
      <msg name="shop_id">Store ID</msg>
      <msg name="hint_shop_id">Required only for an account-level API key</msg>
      <msg name="methods">Payment methods</msg>
      <msg name="hint_methods">Optional: sbp,card,yoomoney,crypto,crypto-old. Empty uses the store settings; dvnet and xrocket aliases are supported</msg>
      <msg name="identity_source">user_identity source</msg>
      <msg name="hint_identity_source">Email is the safe default. External ID uses the stable BILLmanager client ID</msg>
      <msg name="identity_source_email">User email</msg>
      <msg name="identity_source_external_id">BILLmanager client external ID</msg>
      <msg name="franchise_enabled">Send franchise on every payment</msg>
      <msg name="hint_franchise_enabled">Enable only when franchise mode is enabled for the anore store</msg>
      <msg name="franchise_type">Franchise type</msg>
      <msg name="franchise_type_telegram_bot">Telegram bot</msg>
      <msg name="franchise_type_website">HTTPS website</msg>
      <msg name="franchise_address">Franchise address</msg>
      <msg name="hint_franchise_address">Telegram bot username or canonical HTTPS origin without a port or path</msg>
      <msg name="franchise_owner_telegram_id">Owner Telegram ID</msg>
      <msg name="hint_franchise_owner_telegram_id">Positive ID no greater than 9223372036854775807</msg>
      <msg name="franchise_owner_telegram_username">Owner username</msg>
      <msg name="hint_franchise_owner_telegram_username">Optional: @ plus 5–32 ASCII letters, digits, or underscores</msg>
    </messages>
  </lang>
</mgrdata>
